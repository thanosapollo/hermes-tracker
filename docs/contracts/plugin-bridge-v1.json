{
  "version": 1,
  "description": "Hermes plugin-facing bridge contract for Hermes Tracker API v1.",
  "idempotency": {
    "key_header": "Idempotency-Key",
    "actor_header": "X-Actor",
    "mutation_id_header": "X-Mutation-ID",
    "same_input": "replays the original status, body, and mutation ID without another side effect",
    "different_input": "409 conflict"
  },
  "idempotent_mutations": [
    {"name": "create_todo", "path": "/api/v1/repos/{slug}/todos", "status": 201},
    {"name": "comment", "path": "/api/v1/repos/{slug}/todos/{number}/comments", "status": 201},
    {"name": "link", "path": "/api/v1/repos/{slug}/todos/{number}/links", "status": 201},
    {"name": "claim", "path": "/api/v1/repos/{slug}/todos/{number}/claim", "status": 200},
    {"name": "close", "path": "/api/v1/repos/{slug}/todos/{number}/close", "status": 200}
  ],
  "external_reference": {
    "create_path": "/api/v1/repos/{slug}/todos/{number}/external-references",
    "list_path": "/api/v1/repos/{slug}/todos/{number}/external-references",
    "backfill_board_identity": {
      "path": "/api/v1/repos/{slug}/todos/{number}/external-references/{reference_id}/kanban-board-identity",
      "method": "PATCH",
      "body": {"board": "default"},
      "eligibility": "one hermes-kanban reference with a canonical task ID and no existing board metadata",
      "same_board_replay": "returns the existing reference without mutation",
      "different_board": "409 conflict"
    },
    "example": {
      "system": "hermes-kanban",
      "external_id": "t_c23c75a4",
      "url": null,
      "metadata": {"board": "default"}
    }
  },
  "create_todo_example": {
    "path": "/api/v1/repos/proj/todos",
    "headers": {"Idempotency-Key": "plugin-contract-create-1", "X-Actor": "agent"},
    "body": {"title": "Bridge contract TODO", "acceptance_criteria": ["replay is safe"]},
    "status": 201
  }
}
