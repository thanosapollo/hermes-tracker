{
  "mcpServers": {
    "codex-hermes-tracker": {
      "command": "python3",
      "args": ["./scripts/hermes_tracker_mcp.py"],
      "cwd": ".",
      "env_vars": [
        "HERMES_TRACKER_TOKEN",
        "HERMES_TRACKER_URL",
        "HERMES_TRACKER_HOST",
        "HERMES_TRACKER_TOKEN_FILE",
        "HERMES_TRACKER_ACTOR"
      ],
      "tool_timeout_sec": 30
    }
  }
}
